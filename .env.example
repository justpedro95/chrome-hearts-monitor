# ---- Required -------------------------------------------------------------
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXX/YYYYYYYY

# ---- Polling --------------------------------------------------------------
POLL_INTERVAL_SECONDS=60      # seconds between full sweeps
JITTER_SECONDS=15             # random extra delay so requests aren't perfectly periodic
REQUEST_DELAY_SECONDS=1.5     # minimum gap between individual page requests
REQUEST_TIMEOUT=20

# ---- What to alert on -----------------------------------------------------
ALERT_NEW_PRODUCTS=true
ALERT_RESTOCKS=false          # flip to true to also ping on sold out -> in stock
ALERT_PRICE_CHANGES=false
ALERT_NEW_CATEGORIES=false    # ping when a whole new section appears in the nav
ENRICH_PRODUCTS=true          # open each new product page for name/price/image
MAX_ALERTS_PER_CYCLE=40       # safety valve against a 200-item catalog reshuffle

# ---- Scope ----------------------------------------------------------------
# Leave CATEGORIES blank to use the seed list + anything found in the site nav.
# Set it to pin the monitor to specific sections, e.g. CATEGORIES=/scents,/baccarat
CATEGORIES=
DISCOVER_CATEGORIES=true

# ---- Discord cosmetics ----------------------------------------------------
DISCORD_USERNAME=Chrome Hearts Monitor
DISCORD_AVATAR_URL=
ROLE_MENTION=                 # e.g. <@&123456789012345678> to ping a role
EMBED_COLOR=0

# ---- Behaviour ------------------------------------------------------------
STATE_DB=/data/state.db
SEED_ON_FIRST_RUN=true        # post a "monitor online" message after baselining
HEARTBEAT_HOURS=12            # posts a periodic "still working" message; 0 disables
FAILURE_ALERT_THRESHOLD=10    # consecutive failed cycles before it warns you
LOG_LEVEL=INFO
PROXY_URL=                    # optional http(s) proxy, if your VPS IP gets blocked
